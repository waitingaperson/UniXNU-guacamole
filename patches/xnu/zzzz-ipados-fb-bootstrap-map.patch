+/*
+ * Guacamole: io_map() runs before kmem is available and maps the panic log,
+ * the framebuffer and the UART with pmap_map_bd_with_options(), which walks
+ * the leaf tables without allocating them. Pre-allocate the L3 tables for the
+ * early I/O window that starts at virtual_space_start.
+ */
+#define EARLY_IO_WINDOW_SIZE (64ULL * 1024 * 1024)
+
+static void
+init_ptpages_leaf(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end)
+{
+	vm_offset_t ptpage_vaddr;
+	tt_entry_t *l1_tte;
+	tt_entry_t *l2_tte;
+	vm_map_address_t va;
+
+	for (va = start; va < end; va += ARM_TT_L2_SIZE) {
+		l1_tte = tt + L1_TABLE_INDEX(va);
+		if ((*l1_tte & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) !=
+		    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+			continue;
+		}
+		l2_tte = (tt_entry_t *)((*l1_tte & ARM_TTE_TABLE_MASK) -
+		    gPhysBase + gVirtBase) + L2_TABLE_INDEX(va);
+		if (*l2_tte != ARM_TTE_EMPTY) {
+			continue;
+		}
+		ptpage_vaddr = alloc_ptpage(TRUE);
+		*l2_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) |
+		    ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
+		bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+	}
+}
