+
+/* Draw four arbitrary values in the fault rows (used for stack traces). */
+void
+sweet_stage_stackdump(uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL) {
+		return;
+	}
+	sweet_stage_hexline(args, a, 2400);
+	sweet_stage_hexline(args, b, 2520);
+	sweet_stage_hexline(args, c, 2640);
+	sweet_stage_hexline(args, d, 2760);
+}
