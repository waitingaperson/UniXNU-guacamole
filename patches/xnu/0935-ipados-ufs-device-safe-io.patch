 /*
+ * The DMA window is mapped as device memory (ml_io_map): unaligned and wide
+ * vector accesses fault there, so every buffer update is done byte-wise.
+ */
+static void
+dma_clear(uint32_t off, size_t len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)(su.dma + off);
+
+	while (len-- != 0) {
+		*p++ = 0;
+	}
+}
+
+static void
+dma_copy_to(uint32_t off, const void *src, size_t len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)(su.dma + off);
+	const uint8_t *s = src;
+
+	while (len-- != 0) {
+		*p++ = *s++;
+	}
+}
+
+static void
+dma_copy_from(uint32_t off, void *dst, size_t len)
+{
+	volatile const uint8_t *p = (volatile const uint8_t *)(su.dma + off);
+	uint8_t *d = dst;
+
+	while (len-- != 0) {
+		*d++ = *p++;
+	}
+}
