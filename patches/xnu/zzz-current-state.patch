+static int sweet_heartbeat_event;
+static thread_t sweet_boot_thread;
+
+/*
+ * ArmCpu component state, mirrored for the bootstrap pass (which links no
+ * component archives): weak dummies that the strong ArmCpu.o definitions
+ * override whenever the component is linked.
+ */
+__attribute__((weak)) volatile uint32_t armcpu_gic_ready = 0;
+__attribute__((weak)) volatile uint32_t armcpu_registered = 0;
+__attribute__((weak)) volatile uint32_t armcpu_vtimer_intid = 27;
+__attribute__((weak)) volatile uint64_t armcpu_timer_interrupts = 0;
+
+static void *
+sweet_heartbeat_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t beat = 0;
+	extern void sweet_stage_heartbeat(uint64_t value);
+
+	for (;;) {
+		for (int i = 0; i < 2000; i++) {
+			thread_yield_to_preemption();
+		}
+		sweet_stage_heartbeat(++beat);
+		{
+			/*
+			 * Slot 3 (row 2150): the ArmCpu state, so a photo shows whether
+			 * the board's virtual-timer line is wired: the low 48 bits are
+			 * the architectural timer interrupt count, bit 48 GIC ready,
+			 * bit 49 CPU registered, bits 52+ the INTID the driver
+			 * dispatches as the virtual timer.
+			 */
+			extern volatile uint32_t armcpu_gic_ready;
+			extern volatile uint32_t armcpu_registered;
+			extern volatile uint32_t armcpu_vtimer_intid;
+			extern volatile uint64_t armcpu_timer_interrupts;
+			sweet_stage_slot(3, (armcpu_timer_interrupts & 0xffffffffffffULL) |
+			    ((uint64_t)(armcpu_gic_ready != 0) << 48) |
+			    ((uint64_t)(armcpu_registered != 0) << 49) |
+			    ((uint64_t)armcpu_vtimer_intid << 52));
+		}
+
+		if (beat > 1) {
+			extern void sweet_boot_stackdump(thread_t);
+			sweet_boot_stackdump(sweet_boot_thread);
+		}
+	}
+	return NULL;
+}
