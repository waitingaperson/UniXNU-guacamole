diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1812,6 +1812,49 @@
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+extern void sweet_stage_mark(boot_args *args, unsigned int stage);
+
+/*
+ * Guacamole: report how a kernel VA translates through a candidate TTBR1
+ * root. Returns 0 when the mapping is present and executable at EL1, or the
+ * stage number naming the first level that is not usable (24: L1 entry,
+ * 25: L2 entry, 26: L3 entry, 27: privileged execute-never).
+ */
+static unsigned int
+guac_kva_exec_status(tt_entry_t *root, vm_offset_t va)
+{
+	tt_entry_t e1 = root[L1_TABLE_INDEX(va)];
+	tt_entry_t *l2;
+	tt_entry_t e2;
+	pt_entry_t *l3;
+	pt_entry_t p;
+
+	if ((e1 & ARM_TTE_VALID) == 0) {
+		return 24;
+	}
+	if ((e1 & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_TABLE) {
+		return 25;
+	}
+	/* Before the switch the bootstrap maps the tables linearly. */
+	l2 = (tt_entry_t *)((e1 & ARM_TTE_TABLE_MASK) - gPhysBase + gVirtBase);
+	e2 = l2[L2_TABLE_INDEX(va)];
+	if ((e2 & ARM_TTE_VALID) == 0) {
+		return 25;
+	}
+	if ((e2 & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+		return (e2 & ARM_TTE_BLOCK_PNX) ? 27 : 0;
+	}
+	if ((e2 & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_TABLE) {
+		return 25;
+	}
+	l3 = (pt_entry_t *)((e2 & ARM_TTE_TABLE_MASK) - gPhysBase + gVirtBase);
+	p = l3[L3_TABLE_INDEX(va)];
+	if ((p & ARM_PTE_TYPE) != ARM_PTE_TYPE) {
+		return 26;
+	}
+	return (p & ARM_PTE_PNX) ? 27 : 0;
+}
