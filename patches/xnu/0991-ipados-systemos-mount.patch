diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 9b4c502..c9679c0 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7989,6 +7989,76 @@ static const char * init_programs[] = {
 	"/sbin/launchd",
 };
 
+#if defined(XNU_GUAC_SYSTEMOS_MOUNT) && XNU_GUAC_SYSTEMOS_MOUNT
+/*
+ * Bring-up SystemOS cryptex mount. The IPSW keeps the dyld shared cache in the
+ * SystemOS APFS volume (UUID 8846FE78-2910-4297-AF97-D59BB6F8FC16), so launchd
+ * cannot map the cache while only the live OS root is mounted. Before the first
+ * exec, mount that volume read-only at /System/Cryptexes/OS (one of the kernel's
+ * dyld cache search paths) and point dyld at it. The mount payload is the exact
+ * layout sheng qualified against this APFS; anonymous_owner 99 is the bring-up
+ * credential and the mount is verified by the fstype/read-only result.
+ */
+/* Bootstrap pass fallback; the GuacUfsMedia archive provides the strong one. */
+__attribute__((weak)) int
+guac_media_find_volume(const char *uuid, char *path, unsigned long size)
+{
+	(void)uuid;
+	(void)path;
+	(void)size;
+	return 0;
+}
+
+extern int guac_media_find_volume(const char *uuid, char *path, unsigned long size);
+
+static int
+guac_systemos_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
+{
+	static const char cache_uuid[] = "8846FE78-2910-4297-AF97-D59BB6F8FC16";
+	static const char mountpoint[] = "/System/Cryptexes/OS";
+	static const char cache_env[] =
+	    "DYLD_SHARED_CACHE_DIR=/System/Cryptexes/OS/System/Library/Caches/com.apple.dyld";
+	static const char lib_env[] = "DYLD_FALLBACK_LIBRARY_PATH=/System/Cryptexes/OS/usr/lib";
+	char device_path[64] = {0};
+	uint8_t mount_data[0x150] = {0};
+	uint64_t mount_flags = MNT_RDONLY;
+	uint16_t mount_mode = 1;
+	uint32_t anonymous_owner = 99;
+	user64_addr_t spec = scratch + 0x160;
+	user64_addr_t environment[3] = {scratch + 0x400, scratch + 0x600, USER_ADDR_NULL};
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+	    .flags = MNT_RDONLY, .data = scratch + 0x200};
+	int32_t result = 0;
+	int error;
+
+	if (!guac_media_find_volume(cache_uuid, device_path, sizeof(device_path))) {
+		return ENOENT;
+	}
+	memcpy(mount_data, &spec, sizeof(spec));
+	memcpy(mount_data + 8, &mount_flags, sizeof(mount_flags));
+	memcpy(mount_data + 16, &mount_mode, sizeof(mount_mode));
+	memcpy(mount_data + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(mount_data + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	if ((error = copyout("apfs", request.type, 5)) != 0 ||
+	    (error = copyout(mountpoint, request.path, sizeof(mountpoint))) != 0 ||
+	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
+	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) {
+		return error;
+	}
+	error = mount(p, &request, &result);
+	if (error) {
+		return error;
+	}
+	if ((error = copyout(cache_env, environment[0], sizeof(cache_env))) != 0 ||
+	    (error = copyout(lib_env, environment[1], sizeof(lib_env))) != 0 ||
+	    (error = copyout(environment, scratch + 0x500, sizeof(environment))) != 0) {
+		return error;
+	}
+	*envp = scratch + 0x500;
+	return 0;
+}
+#endif /* XNU_GUAC_SYSTEMOS_MOUNT */
+
 /*
  * load_init_program
  *
@@ -8030,6 +8100,13 @@ load_init_program(proc_t p)
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
 	user_addr_t init_envp = USER_ADDR_NULL;
+#if defined(XNU_GUAC_SYSTEMOS_MOUNT) && XNU_GUAC_SYSTEMOS_MOUNT
+	{
+		int cache_error = guac_systemos_prepare(p, (user_addr_t)scratch_addr, &init_envp);
+		printf("GUAC: SystemOS cryptex mount %s (%d)\n",
+		    cache_error ? "failed" : "ok", cache_error);
+	}
+#endif
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
