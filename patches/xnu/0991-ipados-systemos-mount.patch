+/*
+ * Boot-arg sweetlogdump=1: read the persistent ring left by the previous
+ * boot and print the lines worth photographing (crashes, exit reasons,
+ * failures, boot tasks). The ring is otherwise only readable through EDL or
+ * a recovery, neither of which is available on this device.
+ */
+static bool
+sweet_log_contains(const char *hay, const char *needle)
+{
+	size_t n = strlen(needle);
+	for (; *hay; ++hay) {
+		if (strncmp(hay, needle, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+sweet_log_wanted(const char *l)
+{
+	static const char * const keys[] = {
+		"CRASH ", "exited", "Exit", "failed", "Failed", "error", "Error",
+		"panic", "SpringBoard", "xpcproxy", "fairplayd", "bluetoothd",
+		"watchdog", "boot task", "mount", "fsck", "keybag", "AMFI", "abort",
+		"timeout", "Timeout", "not found", "No such",
+	};
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); ++i) {
+		if (sweet_log_contains(l, keys[i])) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+sweet_log_dump(void)
+{
+	uint32_t on = 0;
+	if (!PE_parse_boot_argn("sweetlogdump", &on, sizeof(on)) || !on ||
+	    !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint8_t *buf = (uint8_t *)(su.dma + DMA_BOUNCE);
+	char line[256];
+	unsigned len = 0, shown = 0, scanned = 0;
+	const uint32_t per = 16;	/* 64 KiB per READ(10) */
+	printf("SWEET LOG: dumping the previous ring (block 0x%llx)\n", base + 1);
+	for (uint32_t blk = 0; blk < SWEET_LOG_SIZE / UFS_BLOCK && shown < 400; blk += per) {
+		lck_mtx_lock(&sweet_ufs_lock);
+		int error = ufs_read_blocks(base + 1 + blk, per);
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error) {
+			printf("SWEET LOG: dump read failed (%d)\n", error);
+			break;
+		}
+		for (uint32_t i = 0; i < per * UFS_BLOCK; ++i) {
+			char c = (char)buf[i];
+			if (c == '\n' || len == sizeof(line) - 1) {
+				line[len] = 0;
+				if (len) {
+					++scanned;
+					if (sweet_log_wanted(line)) {
+						printf("LOGDUMP %s\n", line);
+						if (++shown >= 400) {
+							break;
+						}
+					}
+				}
+				len = 0;
+			} else if (c != '\r') {
+				line[len++] = c;
+			}
+		}
+	}
+	printf("SWEET LOG: dump end, %u shown of %u lines\n", shown, scanned);
+}
+
+static void
+sweet_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	sweet_log_dump();
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
