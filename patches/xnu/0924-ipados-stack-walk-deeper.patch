--- a/osfmk/kern/thread.c
+++ b/osfmk/kern/thread.c
@@ -761,6 +761,7 @@
 {
 	extern void sweet_stage_stackdump(uint64_t, uint64_t, uint64_t, uint64_t);
 	uint64_t frames[4] = { 0, 0, 0, 0 };
+	uint64_t deeper[8] = { 0 };
 	uint64_t kstack;
 	uint64_t fp;
 
@@ -773,13 +774,18 @@
 	}
 	/* arm_kernel_saved_state: x[10] then fp */
 	fp = *(volatile uint64_t *)(kstack + 80);
-	for (int i = 0; i < 4 && fp != 0; i++) {
+	for (int i = 0; i < 8 && fp != 0; i++) {
 		if ((fp & 7) != 0 || (fp >> 48) != 0xffff) {
 			break;
 		}
-		frames[i] = *(volatile uint64_t *)(fp + 8);
+		deeper[i] = *(volatile uint64_t *)(fp + 8);
 		fp = *(volatile uint64_t *)fp;
 	}
+	// Skip the context-switch/sleep frames and show the real callers.
+	frames[0] = deeper[4];
+	frames[1] = deeper[5];
+	frames[2] = deeper[6];
+	frames[3] = deeper[7];
 	sweet_stage_stackdump(frames[0], frames[1], frames[2], frames[3]);
 }
 
