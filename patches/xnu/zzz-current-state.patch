+/*
+ * Allocate the DMA buffer before the boot reaches setconf: kmem_alloc_contig
+ * can wait for a long time once the page queues are fragmented, and the UFS
+ * host cannot address memory above 4 GiB (max_pnum bounds the physical range).
+ */
+void
+sweet_ufs_early_alloc(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	ppnum_t pn;
+
+	if (su.dma_ready) {
+		return;
+	}
+	/*
+	 * Preferred: the fixed low DRAM window declared by the device tree.
+	 * The kernel-managed range starts at the kernel window (above 4 GiB),
+	 * and kmem_alloc_contig sleeps forever when it cannot find a
+	 * contiguous run there.
+	 */
+	{
+		kern_return_t kr = SecureDTLookupEntry(NULL, "/ufs-dma", &node);
+		printf("SWEET UFS: /ufs-dma lookup %d\n", kr);
+		if (kr == kSuccess) {
+			kern_return_t gp = SecureDTGetProperty(node, "reg",
+			    (void const **)&reg, &size);
+			printf("SWEET UFS: /ufs-dma reg %d size %u first %llx\n", gp, size,
+			    gp == kSuccess ? (unsigned long long)reg[0] : 0ULL);
+		}
+	}
+	if (SecureDTLookupEntry(NULL, "/ufs-dma", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess &&
+	    size >= 2 * sizeof(uintptr_t) && reg[0] != 0 &&
+	    reg[0] < 0x100000000ULL && reg[1] >= DMA_SIZE) {
+		su.dma = ml_io_map(reg[0], reg[1]);
+		su.dma_pa = reg[0];
+		su.dma_uncached = TRUE;
+		dma_clear(0, (size_t)reg[1]);
+		su.dma_ready = TRUE;
+		printf("SWEET UFS: DMA from device tree pa=%llx va=%llx\n",
+		    su.dma_pa, (unsigned long long)su.dma);
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: early DMA allocation failed\n");
+		return;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		printf("SWEET UFS: early DMA has no physical page\n");
+		return;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.dma_ready = TRUE;
+}
+
+/*
+ * The UniXNU userdata image starts with a 4 KiB SHNGROOT manifest that
+ * describes MiB-aligned disk-image windows (OS, SystemOS). When present, the
+ * root block device is the OS window; otherwise the whole GPT partition is
+ * used as before.
+ */
+#define SHNG_MAGIC "SHNGROOT"
+
+static int
+sweet_ufs_shngroot(void)
+{
+	uint8_t magic[8];
+	uint32_t version = 0, count = 0;
+	uint64_t image_bytes = 0, offset = 0, size = 0;
+	char name[33];
+	int error;
+
+	error = ufs_read_blocks(su.first_block, 1);
+	if (error != 0) {
+		return error;
+	}
+	dma_copy_from(DMA_BOUNCE, magic, sizeof(magic));
+	if (memcmp(magic, SHNG_MAGIC, sizeof(magic)) != 0) {
+		return 0;
+	}
+	dma_copy_from(DMA_BOUNCE + 8, &version, sizeof(version));
+	dma_copy_from(DMA_BOUNCE + 12, &count, sizeof(count));
+	dma_copy_from(DMA_BOUNCE + 16, &image_bytes, sizeof(image_bytes));
+	if (version != 1 || count == 0 || count > 4) {
+		printf("SWEET UFS: SHNGROOT header invalid (v%u, %u windows)\n",
+		    version, count);
+		return EINVAL;
+	}
+	dma_copy_from(DMA_BOUNCE + 24, name, 32);
+	name[32] = 0;
+	dma_copy_from(DMA_BOUNCE + 24 + 32, &offset, sizeof(offset));
+	dma_copy_from(DMA_BOUNCE + 24 + 40, &size, sizeof(size));
+	if (size == 0 || offset >= image_bytes || (offset % UFS_BLOCK) != 0 ||
+	    offset + size > (uint64_t)su.nblocks * UFS_BLOCK) {
+		printf("SWEET UFS: SHNGROOT window \"%s\" outside the partition\n", name);
+		return EINVAL;
+	}
+	printf("SWEET UFS: SHNGROOT \"%s\" offset %llu size %llu of %llu\n",
+	    name, (unsigned long long)offset, (unsigned long long)size,
+	    (unsigned long long)image_bytes);
+	su.first_block += offset / UFS_BLOCK;
+	su.root_bytes = size;
+	su.nblocks = (size + UFS_BLOCK - 1) / UFS_BLOCK;
+	return 0;
+}
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET UFS: no /sweet-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	uint32_t cache = 0, wait = 0;
+	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
+	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
+	su.cache = (cache == 1);
+	su.wait = (wait == 1);
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (!su.dma_ready) {
+		sweet_ufs_early_alloc();
+	}
+	if (!su.dma_ready) {
+		printf("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		}
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	if (!error) {
+		error = sweet_ufs_shngroot();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+#if defined(XNU_GUACMEDIA)
+	{
+		extern int guac_media_publish(uint32_t, uint32_t, uint64_t, uint32_t);
+		int media_error = guac_media_publish((uint32_t)major(su.bdev),
+		    (uint32_t)minor(su.bdev),
+		    su.root_bytes ? su.root_bytes : su.nblocks * UFS_BLOCK,
+		    (uint32_t)su.secsize);
+		printf("SWEET UFS: media publish -> %d\n", media_error);
+	}
+	{
+		extern int guac_ufs_media_publish(void);
+		int media_error = guac_ufs_media_publish();
+		printf("SWEET UFS: block media publish -> %d\n", media_error);
+	}
+#endif
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	su.writable = (rw != 0);
+	su.ready = true;
+	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+#if defined(ARM64_BOARD_CONFIG_GUACAMOLE)
+#endif
+	return 0;
+}
+
+/*
+ * Persistent console log ("sweetlog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring, and once the partition is known
+ * and writable a thread copies new ring blocks to the LAST 4 MiB + 4 KiB of
+ * the partition every ufslogsecs seconds (default 10), far behind the HFS
+ * image at its start. Device block 0 of that area is a header:
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ * ring offset of byte n = n % ring size. Read it from a recovery with
+ * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ */
+#define SWEET_LOG_SIZE          (4u << 20)
+#define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
+#define SWEET_LOG_SECS          10u
+
+static char sweet_log_ring[SWEET_LOG_SIZE];
+static uint64_t _Atomic sweet_log_total;
+static int sweet_log_chan;
+static uint32_t sweet_log_secs = SWEET_LOG_SECS;
+
+/* Called for all console output, any context: never blocks. */
+void sweet_log_append(const char *c, int size);
+
+void
+sweet_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (sweet_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total - *pos > SWEET_LOG_SIZE) {
+		*pos = total - SWEET_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = sweet_log_ring[(*pos + i) % SWEET_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t sweet_log_position(void);
+
+uint64_t
+sweet_log_position(void)
+{
+	return os_atomic_load(&sweet_log_total, relaxed);
+}
+
+struct sweet_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+			dma_copy_to(DMA_BOUNCE, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			dma_clear(DMA_BOUNCE, UFS_BLOCK);
+			dma_copy_to(DMA_BOUNCE, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+/*
+ * Boot-arg sweetlogdump=1: read the persistent ring left by the previous
+ * boot and print the lines worth photographing (crashes, exit reasons,
+ * failures, boot tasks). The ring is otherwise only readable through EDL or
+ * a recovery, neither of which is available on this device.
+ */
+static bool
+sweet_log_contains(const char *hay, const char *needle)
+{
+	size_t n = strlen(needle);
+	for (; *hay; ++hay) {
+		if (strncmp(hay, needle, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+sweet_log_wanted(const char *l)
+{
+	static const char * const keys[] = {
+		"CRASH ", "exited", "Exit", "failed", "Failed", "error", "Error",
+		"panic", "SpringBoard", "xpcproxy", "fairplayd", "bluetoothd",
+		"watchdog", "boot task", "mount", "fsck", "keybag", "AMFI", "abort",
+		"timeout", "Timeout", "not found", "No such",
+	};
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); ++i) {
+		if (sweet_log_contains(l, keys[i])) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+sweet_log_dump(void)
+{
+	uint32_t on = 0;
+	if (!PE_parse_boot_argn("sweetlogdump", &on, sizeof(on)) || !on ||
+	    !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint8_t *buf = (uint8_t *)(su.dma + DMA_BOUNCE);
+	char line[256];
+	unsigned len = 0, shown = 0, scanned = 0;
+	const uint32_t per = 16;	/* 64 KiB per READ(10) */
+	printf("SWEET LOG: dumping the previous ring (block 0x%llx)\n", base + 1);
+	for (uint32_t blk = 0; blk < SWEET_LOG_SIZE / UFS_BLOCK && shown < 400; blk += per) {
+		lck_mtx_lock(&sweet_ufs_lock);
+		int error = ufs_read_blocks(base + 1 + blk, per);
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error) {
+			printf("SWEET LOG: dump read failed (%d)\n", error);
+			break;
+		}
+		for (uint32_t i = 0; i < per * UFS_BLOCK; ++i) {
+			char c = (char)buf[i];
+			if (c == '\n' || len == sizeof(line) - 1) {
+				line[len] = 0;
+				if (len) {
+					++scanned;
+					if (sweet_log_wanted(line)) {
+						printf("LOGDUMP %s\n", line);
+						if (++shown >= 400) {
+							break;
+						}
+					}
+				}
+				len = 0;
+			} else if (c != '\r') {
+				line[len++] = c;
+			}
+		}
+	}
+	printf("SWEET LOG: dump end, %u shown of %u lines\n", shown, scanned);
+}
+
+static void
+sweet_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	sweet_log_dump();
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
