+/*
+ * Guacamole: draw the blocked boot thread's kernel stack return addresses in
+ * the framebuffer. Called from the heartbeat thread when boot output stops,
+ * to identify where the boot thread is stuck.
+ */
+void
+sweet_boot_stackdump(thread_t t)
+{
+	extern void sweet_stage_stackdump(uint64_t, uint64_t, uint64_t, uint64_t);
+	uint64_t frames[4] = { 0, 0, 0, 0 };
+	uint64_t kstack;
+	uint64_t fp;
+
+	if (t == THREAD_NULL || t == current_thread()) {
+		return;
+	}
+	kstack = (uint64_t)(uintptr_t)t->machine.kstackptr;
+	if (kstack == 0) {
+		return;
+	}
+	/* arm_kernel_saved_state: x[10] then fp */
+	fp = *(volatile uint64_t *)(kstack + 80);
+	for (int i = 0; i < 4 && fp != 0; i++) {
+		if ((fp & 7) != 0 || (fp >> 48) != 0xffffff) {
+			break;
+		}
+		frames[i] = *(volatile uint64_t *)(fp + 8);
+		fp = *(volatile uint64_t *)fp;
+	}
+	sweet_stage_stackdump(frames[0], frames[1], frames[2], frames[3]);
+}
