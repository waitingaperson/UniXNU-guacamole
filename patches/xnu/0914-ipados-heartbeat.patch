+
+/*
+ * Independent-of-console heartbeat: a kernel thread redraws this value in the
+ * framebuffer every second so a photo shows whether the kernel is still
+ * making progress when kprintf output stops.
+ */
+void
+sweet_stage_heartbeat(uint64_t value)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL) {
+		return;
+	}
+	sweet_stage_hexline(args, value, 2900);
+}
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -564,6 +564,19 @@
 }
 #endif
 
+static void *
+sweet_heartbeat_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t beat = 0;
+	extern void sweet_stage_heartbeat(uint64_t value);
+
+	for (;;) {
+		sweet_stage_heartbeat(++beat);
+		delay(1000000);
+	}
+	return NULL;
+}
