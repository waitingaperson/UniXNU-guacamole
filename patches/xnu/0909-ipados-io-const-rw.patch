+/*
+ * Guacamole: called just before IOKit starts the early kexts. The kext
+ * __DATA_CONST pages are mapped read-only when the kernel finalizes the boot
+ * protections, but some prelinked kexts (CoreTrust) write lazily initialized
+ * const tables during start. Remap the coalesced segment writable again.
+ */
+void
+sweet_rw_kext_const(void)
+{
+	if (segPLKDATACONSTB == 0 || segSizePLKDATACONST == 0) {
+		return;
+	}
+	arm_vm_page_granular_RWNX(segPLKDATACONSTB, segSizePLKDATACONST, ARM64_GRANULE_ALLOW_BLOCK);
+	__builtin_arm_dsb(DSB_ISH);
+	flush_mmu_tlb();
+}
+
