diff --git a/osfmk/arm64/sweet_stage.c b/osfmk/arm64/sweet_stage.c
new file mode 100644
index 0000000..5ce7b26
--- /dev/null
+++ b/osfmk/arm64/sweet_stage.c
@@ -0,0 +1,97 @@
+/*
+ * Guacamole bring-up markers. DarwinBoot leaves the boot framebuffer mapped
+ * V=P in the bootstrap tables (see the start.s patch), so these writes work
+ * from C with the MMU on and without any IOKit driver. Each mark draws its
+ * stage number as large white digits at the top left; the last number still
+ * visible is the last stage that ran.
+ */
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/boot.h>
+#include <stdint.h>
+
+static boot_args *sweet_stage_args;
+
+void
+sweet_stage_set_args(boot_args *args)
+{
+	sweet_stage_args = args;
+}
+
+/* 5x7 digits, drawn at 16x so the last stage is readable in a photo. */
+static const uint8_t sweet_digits[10][7] = {
+	{ 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e },
+	{ 0x04, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x0e },
+	{ 0x0e, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1f },
+	{ 0x1f, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0e },
+	{ 0x02, 0x06, 0x0a, 0x12, 0x1f, 0x02, 0x02 },
+	{ 0x1f, 0x10, 0x1e, 0x01, 0x01, 0x11, 0x0e },
+	{ 0x06, 0x08, 0x10, 0x1e, 0x11, 0x11, 0x0e },
+	{ 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 },
+	{ 0x0e, 0x11, 0x11, 0x0e, 0x11, 0x11, 0x0e },
+	{ 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c },
+};
+
+static void
+sweet_stage_number(boot_args *args, unsigned int stage)
+{
+	uint64_t base = args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	const uint32_t scale = 16;
+	const uint32_t ox = 16, oy = 16;
+	uint32_t digits[3];
+	unsigned int n = 0, v = stage;
+
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)base;
+
+	/* Clear the three-digit cell so the previous stage does not show. */
+	for (uint32_t y = 0; y < 8 * scale; y++) {
+		volatile uint32_t *line = fb + (uint64_t)(oy + y) * (stride / 4u);
+		for (uint32_t x = 0; x < 3 * 6 * scale; x++) {
+			line[ox + x] = 0;
+		}
+	}
+
+	if (v == 0) {
+		digits[n++] = 0;
+	}
+	while (v != 0 && n < 3) {
+		digits[n++] = v % 10;
+		v /= 10;
+	}
+
+	for (unsigned int i = 0; i < n; i++) {
+		unsigned int d = digits[n - 1 - i];
+		uint32_t dx = ox + i * 6 * scale;
+		for (unsigned int row = 0; row < 7; row++) {
+			uint8_t bits = sweet_digits[d][row];
+			for (unsigned int col = 0; col < 5; col++) {
+				if ((bits & (1u << (4 - col))) == 0) {
+					continue;
+				}
+				for (uint32_t sy = 0; sy < scale; sy++) {
+					volatile uint32_t *line = fb + (uint64_t)(oy + row * scale + sy) * (stride / 4u);
+					for (uint32_t sx = 0; sx < scale; sx++) {
+						line[dx + col * scale + sx] = 0xffffffffu;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+sweet_stage_mark(boot_args *args, unsigned int stage)
+{
+	if (args == NULL) {
+		args = sweet_stage_args;
+	}
+	if (args == NULL || stage > 999) {
+		return;
+	}
+	sweet_stage_number(args, stage);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
