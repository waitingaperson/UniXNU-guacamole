diff --git a/b/osfmk/arm64/sweet_stage.c b/osfmk/arm64/sweet_stage.c
new file mode 100644
index 0000000..49a9260
--- /dev/null
+++ b/osfmk/arm64/sweet_stage.c
@@ -0,0 +1,179 @@
+/*
+ * Guacamole bring-up markers. The bootstrap page tables map the first 2 MiB
+ * of the boot framebuffer V=P, so these writes work from C with the MMU on
+ * and without any IOKit driver. Stages are 128x4 blocks at
+ * y=40+(stage&7)*20, one column per group: 0-11 x=300, 12-15 x=500,
+ * 16-19 x=700, 20-23 x=900, 24-27 x=1100. Stages 28+ use a second band at
+ * y=220+(stage&7)*20, x=300 for 28-35. Stage 7 is immediately before
+ * arm_vm_init tears down the bootstrap TTBR0.
+ */
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/boot.h>
+#include <stdint.h>
+
+static boot_args *sweet_stage_args;
+
+void
+sweet_stage_set_args(boot_args *args)
+{
+	sweet_stage_args = args;
+}
+
+
+/* 5x7 digits, drawn at 10x so the last stage is readable in a photo. */
+static const uint8_t sweet_digits[10][7] = {
+	{ 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e },
+	{ 0x04, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x0e },
+	{ 0x0e, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1f },
+	{ 0x1f, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0e },
+	{ 0x02, 0x06, 0x0a, 0x12, 0x1f, 0x02, 0x02 },
+	{ 0x1f, 0x10, 0x1e, 0x01, 0x01, 0x11, 0x0e },
+	{ 0x06, 0x08, 0x10, 0x1e, 0x11, 0x11, 0x0e },
+	{ 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 },
+	{ 0x0e, 0x11, 0x11, 0x0e, 0x11, 0x11, 0x0e },
+	{ 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c },
+};
+
+static void
+sweet_stage_number(boot_args *args, unsigned int stage)
+{
+	uint64_t base = args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	const uint32_t scale = 10;
+	const uint32_t ox = 16, oy = 16;
+	uint32_t digits[3];
+	unsigned int n = 0, v = stage;
+
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)base;
+
+	for (uint32_t y = 0; y < 8 * scale; y++) {
+		volatile uint32_t *line = fb + (uint64_t)(oy + y) * (stride / 4u);
+		for (uint32_t x = 0; x < 3 * 6 * scale; x++) {
+			line[ox + x] = 0;
+		}
+	}
+
+	if (v == 0) {
+		digits[n++] = 0;
+	}
+	while (v != 0 && n < 3) {
+		digits[n++] = v % 10;
+		v /= 10;
+	}
+
+	for (unsigned int i = 0; i < n; i++) {
+		unsigned int d = digits[n - 1 - i];
+		uint32_t dx = ox + i * 6 * scale;
+		for (unsigned int row = 0; row < 7; row++) {
+			uint8_t bits = sweet_digits[d][row];
+			for (unsigned int col = 0; col < 5; col++) {
+				if ((bits & (1u << (4 - col))) == 0) {
+					continue;
+				}
+				for (uint32_t sy = 0; sy < scale; sy++) {
+					volatile uint32_t *line = fb + (uint64_t)(oy + row * scale + sy) * (stride / 4u);
+					for (uint32_t sx = 0; sx < scale; sx++) {
+						line[dx + col * scale + sx] = 0xffffffffu;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+sweet_stage_mark(boot_args *args, unsigned int stage)
+{
+	if (args == NULL) {
+		args = sweet_stage_args;
+	}
+	static const uint32_t colors[160] = {
+		0xffff00ffu, 0xffffff00u, 0xff0000ffu, 0xffffff00u,
+		0xff00ffffu, 0xffff00ffu, 0xff808080u, 0xffffffffu,
+		0xff00ffffu, 0xff0080ffu, 0xff8000ffu, 0xff00ff80u,
+		0xffff0080u, 0xff80ff00u, 0xff4080c0u, 0xffc08040u,
+		0xff20c0ffu, 0xffff8040u, 0xffc020ffu, 0xff80c020u,
+		0xff00ff40u, 0xffff40ffu, 0xff40ffffu, 0xffffff80u,
+		0xffff0000u, 0xffff8000u, 0xffffff40u, 0xffff00ffu,
+		0xff00ff80u, 0xff8000ffu, 0xffff0080u, 0xff80ff80u,
+		0xff8080ffu, 0xffff8080u, 0xff80ffffu, 0xffffff80u,
+		0xff20ff80u, 0xffff2080u, 0xff80ff20u, 0xff2080ffu,
+		0xffff8020u, 0xff20ffffu, 0xffff20ffu, 0xff80ffffu,
+		0xff40ff80u, 0xffff4080u, 0xff80ff40u, 0xff4080ffu,
+		0xffffc040u, 0xff40c0ffu, 0xffc0ff40u, 0xffff40c0u,
+		0xff40ffc0u, 0xffc040ffu, 0xffffc0c0u, 0xffc0c0ffu,
+		0xff80c0ffu, 0xffffc080u, 0xffc0ff80u, 0xffff80c0u,
+		0xff80ffc0u, 0xffc080ffu, 0xffffc0ffu, 0xffc0ffffu,
+		0xff60ff60u, 0xffff6060u, 0xff6060ffu, 0xffffff60u,
+		0xff60ffffu, 0xffff60ffu, 0xffa0a0a0u, 0xffffffffu,
+		0xff202020u, 0xffff8000u, 0xff0080ffu, 0xff80ff00u,
+		0xffff0080u, 0xff00ff80u, 0xff8000ffu, 0xff00ffffu,
+		0xffff4040u, 0xff40ff40u, 0xff4040ffu, 0xffffff40u,
+		0xff40ffffu, 0xffff40ffu, 0xffc0c0c0u, 0xff808080u,
+		0xff202060u, 0xffff6020u, 0xff2060ffu, 0xff60ff20u,
+		0xffff2060u, 0xff20ff60u, 0xff6020ffu, 0xffff2060u,
+		0xffa02020u, 0xff20a020u, 0xff2020a0u, 0xffa0a020u,
+		0xff20a0a0u, 0xffa020a0u, 0xffe0e0e0u, 0xff606060u,
+		0xffc04040u, 0xff40c040u, 0xff4040c0u, 0xffc0c040u,
+		0xff40c0c0u, 0xffc040c0u, 0xffffe0e0u, 0xff404040u,
+		0xffffff00u, 0xff00ffffu, 0xffff00ffu, 0xff00ff00u,
+		0xffff0000u, 0xff0000ffu, 0xff808080u, 0xffc0c0c0u,
+		0xff800000u, 0xff008000u, 0xff000080u, 0xff808000u,
+		0xff008080u, 0xff800080u, 0xff404040u, 0xffffffffu,
+		0xff400000u, 0xff004000u, 0xff000040u, 0xff404000u,
+		0xff004040u, 0xff400040u, 0xff202020u, 0xffe0e0e0u,
+		0xffc00000u, 0xff00c000u, 0xff0000c0u, 0xffc0c000u,
+		0xff00c0c0u, 0xffc000c0u, 0xff808000u, 0xff008080u,
+		0xffff8080u, 0xff80ff80u, 0xff8080ffu, 0xffffff80u,
+		0xff80ffffu, 0xffff80ffu, 0xffc0c0c0u, 0xff606060u,
+		0xffff0000u, 0xff00ff00u, 0xff0000ffu, 0xffffff00u,
+		0xff00ffffu, 0xffff00ffu, 0xff9f9f9fu, 0xff5f5f5fu
+	};
+
+	if (args == NULL || stage > 999) {
+		return;
+	}
+	uint64_t base = args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)base;
+	/* Extended stages only need the number; the 160-entry color table and
+	 * the block band stop at 159. */
+	if (stage > 159) {
+		sweet_stage_number(args, stage);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		return;
+	}
+	if (stage == 0) {
+		for (uint32_t row = 0; row < 144; row++) {
+			volatile uint32_t *line = fb + (uint64_t)(40u + row) * (stride / 4u);
+			for (uint32_t col = 300; col < 1100; col++) {
+				line[col] = 0;
+			}
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	/* Keep every marker below 2 MiB: the bootstrap maps only the first
+	 * 2 MiB of the framebuffer V=P, so y=380 would fault. */
+	uint32_t y = stage < 28u ? 40u + (stage & 7u) * 20u :
+	    (stage < 128u ? 220u + ((stage - 28u) & 7u) * 20u :
+	    220u + ((stage - 128u) & 7u) * 20u);
+	uint32_t x = stage < 12u ? 300u : (stage < 16u ? 500u :
+	    (stage < 20u ? 700u : (stage < 24u ? 900u :
+	    (stage < 28u ? 1100u : (stage < 128u ?
+	    300u + ((stage < 80u ? stage - 28u : stage - 80u) / 8u) * 200u : 300u)))));
+	for (uint32_t row = 0; row < 4; row++) {
+		volatile uint32_t *line = fb + (uint64_t)(y + row) * (stride / 4u);
+		for (uint32_t col = x; col < x + 128u; col++) {
+			line[col] = colors[stage];
+		}
+	}
+	sweet_stage_number(args, stage);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
