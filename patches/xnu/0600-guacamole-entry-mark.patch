diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -460,6 +460,28 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+	/*
+	 * Guacamole: a 64x32 white band at the bottom-left of the ABL
+	 * framebuffer, written before any page table or MMU setup. Seeing it
+	 * proves the 4K kernel entry ran; its absence points at the prelink,
+	 * the entry address or DarwinBoot.
+	 */
+	MOV64	x0, (0x9c000000 + 64 * 4320)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+1:
+	mov		x3, #64
+	mov		x5, x0
+2:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	1b
+	dsb		sy
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
