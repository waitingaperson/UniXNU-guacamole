--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -107,6 +107,7 @@
 	int bmajor, cmajor;
 	dev_t bdev;
 	bool dma_ready;
+	bool dma_uncached;                      /* device-mapped window: no cache ops */
 	bool ready;
 } su;
 
@@ -128,12 +129,20 @@
 static void
 dma_sync(uint32_t off, uint32_t len)
 {
+	if (su.dma_uncached) {
+		__builtin_arm_dsb(0xf);
+		return;
+	}
 	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
 }
 
 static void
 dma_clean(uint32_t off, uint32_t len)
 {
+	if (su.dma_uncached) {
+		__builtin_arm_dsb(0xf);
+		return;
+	}
 	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
 }
 
