diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index bca4c7c..9a5f645 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -626,6 +626,46 @@ Lbootstrap_tables_ready:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+	/*
+	 * Guacamole: map the first 2 MiB of the boot framebuffer V=P so the
+	 * stage markers can be written with the MMU on. DarwinBoot leaves no
+	 * framebuffer mapping behind; without this the first marker faults as
+	 * soon as translation is enabled.
+	 */
+	ldr		x6, [x20, #0x28]			// Video.v_baseAddr
+	cbz		x6, 5f
+	MOV64	x9, ~0x1fffff
+	and		x6, x6, x9
+	ubfx	x7, x6, #30, #2				// L1 index
+	ldr		x8, [x25, x7, lsl #3]
+	and		x9, x8, #3
+	cmp		x9, #3					// existing L2 table?
+	b.eq	3f
+	tst		x8, #1					// existing block mapping?
+	b.ne	5f
+	/* Take one page from the bootstrap pool for a zeroed L2 table. */
+	add		x10, x25, #(BOOTSTRAP_TABLE_BYTES >> 12), lsl #12
+	cmp		x2, x10
+	b.hs	5f
+	mov		x8, x2
+	add		x2, x2, #0x1000
+	mov		x10, x8
+	mov		x11, #512
+2:
+	str		xzr, [x10], #8
+	subs	x11, x11, #1
+	b.ne	2b
+	mov		x10, #(ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)
+	orr		x8, x8, x10
+	str		x8, [x25, x7, lsl #3]
+3:
+	and		x8, x8, #(ARM_TTE_TABLE_MASK)
+	ubfx	x9, x6, #21, #9				// 2 MiB L2 index
+	MOV64	x10, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x10, x10, x6
+	str		x10, [x8, x9, lsl #3]
+	dsb		ish
+5:
 
 	b		common_start
 
