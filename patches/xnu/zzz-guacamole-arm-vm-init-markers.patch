+/*
+ * Guacamole: io_map() runs before kmem is available and maps the panic log,
+ * the framebuffer and the UART with pmap_map_bd_with_options(), which walks
+ * the leaf tables without allocating them. Pre-allocate the L3 tables for the
+ * early I/O window that starts at virtual_space_start.
+ */
+#define EARLY_IO_WINDOW_SIZE (64ULL * 1024 * 1024)
+
+static void
+init_ptpages_leaf(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end)
+{
+	vm_offset_t ptpage_vaddr;
+	tt_entry_t *l1_tte;
+	tt_entry_t *l2_tte;
+	vm_map_address_t va;
+
+	for (va = start; va < end; va += ARM_TT_L2_SIZE) {
+		l1_tte = tt + L1_TABLE_INDEX(va);
+		if ((*l1_tte & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) !=
+		    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+			continue;
+		}
+		l2_tte = (tt_entry_t *)((*l1_tte & ARM_TTE_TABLE_MASK) -
+		    gPhysBase + gVirtBase) + L2_TABLE_INDEX(va);
+		if (*l2_tte != ARM_TTE_EMPTY) {
+			continue;
+		}
+		ptpage_vaddr = alloc_ptpage(TRUE);
+		*l2_tte = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) |
+		    ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
+		bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+	}
+}
+
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+extern void sweet_stage_mark(boot_args *args, unsigned int stage);
+
+/*
+ * Guacamole: report how a kernel VA translates through a candidate TTBR1
+ * root. Returns 0 when the mapping is present and executable at EL1, or the
+ * stage number naming the first level that is not usable (24: L1 entry,
+ * 25: L2 entry, 26: L3 entry, 27: privileged execute-never).
+ */
+static unsigned int
+guac_kva_exec_status(tt_entry_t *root, vm_offset_t va)
+{
+	tt_entry_t e1 = root[L1_TABLE_INDEX(va)];
+	tt_entry_t *l2;
+	tt_entry_t e2;
+	pt_entry_t *l3;
+	pt_entry_t p;
+
+	if ((e1 & ARM_TTE_VALID) == 0) {
+		return 24;
+	}
+	if ((e1 & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_TABLE) {
+		return 25;
+	}
+	/* Before the switch the bootstrap maps the tables linearly. */
+	l2 = (tt_entry_t *)((e1 & ARM_TTE_TABLE_MASK) - gPhysBase + gVirtBase);
+	e2 = l2[L2_TABLE_INDEX(va)];
+	if ((e2 & ARM_TTE_VALID) == 0) {
+		return 25;
+	}
+	if ((e2 & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+		return (e2 & ARM_TTE_BLOCK_PNX) ? 27 : 0;
+	}
+	if ((e2 & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_TABLE) {
+		return 25;
+	}
+	l3 = (pt_entry_t *)((e2 & ARM_TTE_TABLE_MASK) - gPhysBase + gVirtBase);
+	p = l3[L3_TABLE_INDEX(va)];
+	if ((p & ARM_PTE_TYPE) != ARM_PTE_TYPE) {
+		return 26;
+	}
+	return (p & ARM_PTE_PNX) ? 27 : 0;
+}
