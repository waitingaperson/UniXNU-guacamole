+++ b/osfmk/arm64/sweet_stage.c
@@ -0,0 +1,37 @@
+/*
+ * Guacamole bring-up markers. The bootstrap page tables map the first 2 MiB
+ * of the boot framebuffer V=P, so these writes work from C with the MMU on
+ * and without any IOKit driver. Each stage is a 128x16 block at x=300,
+ * y=340+stage*20; stage 0 is the C entry and stage 7 is immediately before
+ * arm_vm_init tears down the bootstrap TTBR0.
+ */
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/boot.h>
+#include <stdint.h>
+
+void
+sweet_stage_mark(boot_args *args, unsigned int stage)
+{
+	static const uint32_t colors[8] = {
+		0xffff0000u, 0xff00ff00u, 0xff0000ffu, 0xffffff00u,
+		0xff00ffffu, 0xffff00ffu, 0xff808080u, 0xffffffffu
+	};
+
+	if (args == NULL || stage > 7) {
+		return;
+	}
+	uint64_t base = args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)base;
+	uint32_t y = 340u + stage * 20u;
+	for (uint32_t row = 0; row < 16; row++) {
+		volatile uint32_t *line = fb + (uint64_t)(y + row) * (stride / 4u);
+		for (uint32_t col = 300; col < 428; col++) {
+			line[col] = colors[stage];
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
