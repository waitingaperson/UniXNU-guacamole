diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index e5336e5..47b29d7 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,30 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+	/*
+	 * Guacamole: a 256x128 white block at y=300, using the framebuffer
+	 * base from boot_args->Video rather than a hard-coded address. It runs
+	 * before any page table or MMU setup. Seeing it proves the 4K kernel
+	 * entry ran; its absence points at the entry address or DarwinBoot.
+	 */
+	ldr		x6, [x20, #0x28]			// Video.v_baseAddr
+	ldr		x4, [x20, #0x38]			// Video.v_rowBytes
+	mov		x7, #300
+	madd	x0, x7, x4, x6
+	mov		w1, #-1
+	mov		x2, #128
+1:
+	mov		x3, #256
+	mov		x5, x0
+2:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	1b
+	dsb		sy
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
