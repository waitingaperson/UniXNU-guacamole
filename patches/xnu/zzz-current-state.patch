diff --git a/osfmk/arm64/sweet_stage.c b/osfmk/arm64/sweet_stage.c
new file mode 100644
index 0000000..946f99e
--- /dev/null
+++ b/osfmk/arm64/sweet_stage.c
@@ -0,0 +1,364 @@
+/*
+ * Guacamole bring-up markers. DarwinBoot leaves the boot framebuffer mapped
+ * V=P in the bootstrap tables (see the start.s patch), so these writes work
+ * from C with the MMU on and without any IOKit driver. Each mark draws its
+ * stage number as large white digits at the top left; the last number still
+ * visible is the last stage that ran.
+ */
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/boot.h>
+#include <machine/machine_routines.h>
+#include <stdint.h>
+
+static boot_args *sweet_stage_args;
+
+void
+sweet_stage_set_args(boot_args *args)
+{
+	sweet_stage_args = args;
+}
+
+/* 5x7 digits, drawn at 16x so the last stage is readable in a photo. */
+static const uint8_t sweet_digits[10][7] = {
+	{ 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e },
+	{ 0x04, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x0e },
+	{ 0x0e, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1f },
+	{ 0x1f, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0e },
+	{ 0x02, 0x06, 0x0a, 0x12, 0x1f, 0x02, 0x02 },
+	{ 0x1f, 0x10, 0x1e, 0x01, 0x01, 0x11, 0x0e },
+	{ 0x06, 0x08, 0x10, 0x1e, 0x11, 0x11, 0x0e },
+	{ 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 },
+	{ 0x0e, 0x11, 0x11, 0x0e, 0x11, 0x11, 0x0e },
+	{ 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c },
+};
+
+static void
+sweet_stage_number(boot_args *args, unsigned int stage)
+{
+	uint64_t base = args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	const uint32_t scale = 16;
+	const uint32_t ox = 16, oy = 16;
+	uint32_t digits[3];
+	unsigned int n = 0, v = stage;
+
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)base;
+
+	/* Clear the three-digit cell so the previous stage does not show. */
+	for (uint32_t y = 0; y < 8 * scale; y++) {
+		volatile uint32_t *line = fb + (uint64_t)(oy + y) * (stride / 4u);
+		for (uint32_t x = 0; x < 3 * 6 * scale; x++) {
+			line[ox + x] = 0;
+		}
+	}
+
+	if (v == 0) {
+		digits[n++] = 0;
+	}
+	while (v != 0 && n < 3) {
+		digits[n++] = v % 10;
+		v /= 10;
+	}
+
+	for (unsigned int i = 0; i < n; i++) {
+		unsigned int d = digits[n - 1 - i];
+		uint32_t dx = ox + i * 6 * scale;
+		for (unsigned int row = 0; row < 7; row++) {
+			uint8_t bits = sweet_digits[d][row];
+			for (unsigned int col = 0; col < 5; col++) {
+				if ((bits & (1u << (4 - col))) == 0) {
+					continue;
+				}
+				for (uint32_t sy = 0; sy < scale; sy++) {
+					volatile uint32_t *line = fb + (uint64_t)(oy + row * scale + sy) * (stride / 4u);
+					for (uint32_t sx = 0; sx < scale; sx++) {
+						line[dx + col * scale + sx] = 0xffffffffu;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+sweet_stage_mark(boot_args *args, unsigned int stage)
+{
+	if (args == NULL) {
+		args = sweet_stage_args;
+	}
+	if (args == NULL || stage > 999) {
+		return;
+	}
+	sweet_stage_number(args, stage);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Bring-up fault dump: the panic text console is too small to photograph
+ * reliably, so the fault numbers are also drawn as large hex digits
+ * (16 digits, 12x scale) at fixed rows: pc, lr, far, esr.
+ */
+static const uint8_t sweet_hexfont[16][7] = {
+	{ 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e },
+	{ 0x04, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x0e },
+	{ 0x0e, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1f },
+	{ 0x1f, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0e },
+	{ 0x02, 0x06, 0x0a, 0x12, 0x1f, 0x02, 0x02 },
+	{ 0x1f, 0x10, 0x1e, 0x01, 0x01, 0x11, 0x0e },
+	{ 0x06, 0x08, 0x10, 0x1e, 0x11, 0x11, 0x0e },
+	{ 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 },
+	{ 0x0e, 0x11, 0x11, 0x0e, 0x11, 0x11, 0x0e },
+	{ 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c },
+	{ 0x0e, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11 },
+	{ 0x1e, 0x11, 0x11, 0x1e, 0x11, 0x11, 0x1e },
+	{ 0x0e, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0e },
+	{ 0x1e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1e },
+	{ 0x1f, 0x10, 0x1e, 0x10, 0x10, 0x10, 0x1f },
+	{ 0x1f, 0x10, 0x1e, 0x10, 0x10, 0x10, 0x10 },
+};
+
+static uint64_t sweet_fault[4];
+static int sweet_fault_valid;
+/* Kernel VA of the framebuffer, set once the VM is up (ml_io_map). */
+static uint64_t sweet_stage_fb_va;
+/*
+ * Set by the panic path (sweet_stage_panic_backtrace): the heartbeat,
+ * stackdump and fault redraws stop, so a photo keeps the panicking thread's
+ * backtrace.
+ */
+volatile uint32_t sweet_stage_panic_freeze;
+
+void
+sweet_stage_map_fb(boot_args *args)
+{
+	uint64_t size;
+
+	if (args == NULL || args->Video.v_baseAddr == 0 || args->Video.v_rowBytes == 0) {
+		return;
+	}
+	size = (uint64_t)args->Video.v_rowBytes * args->Video.v_height;
+	size = (size + 0xfff) & ~0xfffull;
+	if (size == 0) {
+		return;
+	}
+	sweet_stage_fb_va = (uint64_t)ml_io_map((vm_offset_t)args->Video.v_baseAddr, (vm_size_t)size);
+}
+
+static void
+sweet_stage_hexline(boot_args *args, uint64_t value, unsigned int y)
+{
+	uint64_t base = sweet_stage_fb_va ? sweet_stage_fb_va : args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	const uint32_t scale = 12;
+	const uint32_t ox = 24;
+	volatile uint32_t *fb;
+
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	fb = (volatile uint32_t *)(uintptr_t)base;
+	for (uint32_t row = 0; row < 7 * scale; row++) {
+		volatile uint32_t *line = fb + (uint64_t)(y + row) * (stride / 4u);
+		for (uint32_t x = 0; x < 16 * 6 * scale; x++) {
+			line[ox + x] = 0;
+		}
+	}
+	for (unsigned int i = 0; i < 16; i++) {
+		unsigned int digit = (unsigned int)((value >> (60 - 4 * i)) & 0xf);
+		uint32_t dx = ox + i * 6 * scale;
+		for (unsigned int row = 0; row < 7; row++) {
+			uint8_t bits = sweet_hexfont[digit][row];
+			for (unsigned int col = 0; col < 5; col++) {
+				if ((bits & (1u << (4 - col))) == 0) {
+					continue;
+				}
+				for (uint32_t sy = 0; sy < scale; sy++) {
+					volatile uint32_t *line = fb + (uint64_t)(y + row * scale + sy) * (stride / 4u);
+					for (uint32_t sx = 0; sx < scale; sx++) {
+						line[dx + col * scale + sx] = 0xffffffffu;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+sweet_stage_faultredraw(void)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL || !sweet_fault_valid || sweet_stage_panic_freeze) {
+		return;
+	}
+	sweet_stage_hexline(args, sweet_fault[0], 2400);
+	sweet_stage_hexline(args, sweet_fault[1], 2520);
+	sweet_stage_hexline(args, sweet_fault[2], 2640);
+	sweet_stage_hexline(args, sweet_fault[3], 2760);
+}
+
+void
+sweet_stage_faultdump(uint64_t pc, uint64_t lr, uint64_t far, uint64_t esr)
+{
+	/*
+	 * Keep the first fault seen: a nested panic would otherwise replace the
+	 * numbers of the fault that actually started the panic.
+	 */
+	if (!sweet_fault_valid) {
+		sweet_fault[0] = pc;
+		sweet_fault[1] = lr;
+		sweet_fault[2] = far;
+		sweet_fault[3] = esr;
+		sweet_fault_valid = 1;
+	}
+	sweet_stage_faultredraw();
+}
+
+/*
+ * Independent-of-console heartbeat: a kernel thread redraws this value in the
+ * framebuffer every second so a photo shows whether the kernel is still
+ * making progress when kprintf output stops.
+ */
+void
+sweet_stage_heartbeat(uint64_t value)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL || sweet_stage_panic_freeze) {
+		return;
+	}
+	sweet_stage_hexline(args, value, 2900);
+}
+
+/* Draw four arbitrary values in the fault rows (used for stack traces). */
+void
+sweet_stage_stackdump(uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL || sweet_stage_panic_freeze) {
+		return;
+	}
+	sweet_stage_hexline(args, a, 2400);
+	sweet_stage_hexline(args, b, 2520);
+	sweet_stage_hexline(args, c, 2640);
+	sweet_stage_hexline(args, d, 2760);
+}
+
+/* Dense hex line for the panic backtrace: scale 8, 16 digits, band height 56. */
+static void
+sweet_stage_backline(boot_args *args, uint64_t value, unsigned int y)
+{
+	uint64_t base = sweet_stage_fb_va ? sweet_stage_fb_va : args->Video.v_baseAddr;
+	uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+	const uint32_t scale = 8;
+	const uint32_t ox = 24;
+	volatile uint32_t *fb;
+
+	if (base == 0 || stride < 4) {
+		return;
+	}
+	fb = (volatile uint32_t *)(uintptr_t)base;
+	for (uint32_t row = 0; row < 7 * scale; row++) {
+		volatile uint32_t *line = fb + (uint64_t)(y + row) * (stride / 4u);
+		for (uint32_t x = 0; x < 16 * 6 * scale; x++) {
+			line[ox + x] = 0;
+		}
+	}
+	for (unsigned int i = 0; i < 16; i++) {
+		unsigned int digit = (unsigned int)((value >> (60 - 4 * i)) & 0xf);
+		uint32_t dx = ox + i * 6 * scale;
+		for (unsigned int row = 0; row < 7; row++) {
+			uint8_t bits = sweet_hexfont[digit][row];
+			for (unsigned int col = 0; col < 5; col++) {
+				if ((bits & (1u << (4 - col))) == 0) {
+					continue;
+				}
+				for (uint32_t sy = 0; sy < scale; sy++) {
+					volatile uint32_t *line = fb + (uint64_t)(y + row * scale + sy) * (stride / 4u);
+					for (uint32_t sx = 0; sx < scale; sx++) {
+						line[dx + col * scale + sx] = 0xffffffffu;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Panic path (called from panic_spin_forever): freeze the heartbeat and
+ * stackdump redraws, then draw the panicking thread's frame-pointer chain as
+ * up to 12 dense lines at rows 2400+60*i, innermost first — a photo then
+ * carries the whole backtrace instead of one panic line.
+ */
+void
+sweet_stage_panic_backtrace(void)
+{
+	boot_args *args = sweet_stage_args;
+	uint64_t fp;
+
+	if (args == NULL) {
+		return;
+	}
+	sweet_stage_panic_freeze = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	{
+		/* One clean layout: clear everything below the console strip first. */
+		uint64_t base = sweet_stage_fb_va ? sweet_stage_fb_va : args->Video.v_baseAddr;
+		uint32_t stride = (uint32_t)args->Video.v_rowBytes;
+		if (base != 0 && stride >= 4) {
+			volatile uint32_t *fb = (volatile uint32_t *)(uintptr_t)base;
+			for (unsigned int y = 2360; y < args->Video.v_height; y++) {
+				volatile uint32_t *line = fb + (uint64_t)y * (stride / 4u);
+				for (uint32_t x = 0; x < 16 * 6 * 12 + 32; x++) {
+					line[x] = 0;
+				}
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+	}
+
+	fp = (uint64_t)(uintptr_t)__builtin_frame_address(0);
+	for (unsigned int i = 0; i < 12 && fp != 0; i++) {
+		if ((fp & 7) != 0 || (fp >> 48) != 0xffff) {
+			break;
+		}
+		sweet_stage_backline(args, *(volatile uint64_t *)(fp + 8), 2400 + 60 * i);
+		fp = *(volatile uint64_t *)fp;
+	}
+}
+
+/* Four values in the upper strip, out of the heartbeat sampler's rows. */
+/* One value in a dedicated row, so concurrent boot threads do not clobber
+ * each other's stage markers. */
+void
+sweet_stage_slot(unsigned int slot, uint64_t value)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL || slot > 3) {
+		return;
+	}
+	sweet_stage_hexline(args, value, 2400 + slot * 100);
+}
+
+void
+sweet_stage_field(uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	boot_args *args = sweet_stage_args;
+
+	if (args == NULL) {
+		return;
+	}
+	sweet_stage_hexline(args, a, 2400);
+	sweet_stage_hexline(args, b, 2500);
+	sweet_stage_hexline(args, c, 2600);
+	sweet_stage_hexline(args, d, 2700);
+}
