--- a/osfmk/arm64/start.s	2026-10-22 10:58:35.687167221 +0800
+++ b/osfmk/arm64/start.s	2026-10-22 11:00:48.394352669 +0800
@@ -648,6 +648,41 @@
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+	/*
+	 * Guacamole: map the first 2 MiB of the boot framebuffer V=P so a
+	 * post-MMU marker can be written with the MMU on. The page is taken
+	 * from the bootstrap table pool only when the framebuffer's L1 slot
+	 * is still invalid; an existing table is reused and a block mapping
+	 * is left alone.
+	 */
+	ldr		x6, [x20, #0x28]			// Video.v_baseAddr
+	MOV64	x9, ~0x1fffff
+	and		x6, x6, x9
+	ubfx	x7, x6, #30, #2				// L1 index
+	ldr		x8, [x25, x7, lsl #3]
+	and		x9, x8, #3
+	cmp		x9, #3					// existing L2 table?
+	b.eq	3f
+	tst		x8, #1					// existing block mapping?
+	b.ne	4f
+	mov		x8, x2					// allocate a zeroed L2 page
+	add		x2, x2, #0x1000
+	mov		x10, x8
+	mov		x11, #512
+2:
+	str		xzr, [x10], #8
+	subs	x11, x11, #1
+	b.ne	2b
+	mov		x10, #(ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)
+	orr		x8, x8, x10
+	str		x8, [x25, x7, lsl #3]
+3:
+	and		x8, x8, #(ARM_TTE_TABLE_MASK)
+	ubfx	x9, x6, #21, #9				// 2 MiB L2 index
+	MOV64	x10, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x10, x10, x6
+	str		x10, [x8, x9, lsl #3]
+4:
 
 	b		common_start
 
@@ -781,6 +816,29 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+	/*
+	 * Guacamole: magenta block at y=200. Seeing it means the MMU is on and
+	 * the first 2 MiB of the framebuffer is mapped V=P.
+	 */
+	ldr		x6, [x20, #0x28]
+	ldr		x4, [x20, #0x38]
+	mov		x7, #200
+	madd	x0, x7, x4, x6
+	mov		w1, #0x00ff
+	movk	w1, #0xffff, lsl #16
+	mov		x2, #128
+1:
+	mov		x3, #256
+	mov		x5, x0
+2:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	1b
+	dsb		sy
+
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
